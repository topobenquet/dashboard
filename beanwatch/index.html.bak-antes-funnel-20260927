<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="robots" content="noindex, nofollow">
<title>Bean Watch · Performance Dashboard</title>
<link rel="icon" href="logo.png">
<style>
:root{
  --navy:#111111; --navy2:#1E1E1E; --gold:#8AA0DB; --gold2:#DCE3F5; --bg:#F6F6F3; --card:#FFFFFF;
  --ink:#1A1A1A; --mut:#6E6E6E; --line:#E4E4DE; --blue:#0099FF; --br:#A3A3A3;
  --good:#2E8B57; --warn:#C98A1B; --bad:#C0392B; color-scheme:light;
}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif;background:var(--bg);color:var(--ink);font-size:13px;line-height:1.45}
.wrap{max-width:1320px;margin:0 auto;padding:0 20px 40px}
header.top{background:var(--navy);color:#fff}
header.top .wrap{display:flex;align-items:center;justify-content:space-between;gap:16px;padding-top:18px;padding-bottom:18px;flex-wrap:wrap}
header.top img{height:34px;width:34px;border-radius:50%;display:block}
header.top .brand{font-family:Georgia,"Times New Roman",serif;font-size:21px;color:#fff;letter-spacing:.02em}
header.top .ttl{font-size:13px;color:#C9C9C9;letter-spacing:.12em;text-transform:uppercase}
header.top .meta{font-size:11.5px;color:#C9C9C9;text-align:right}
header.top .meta b{color:#fff;font-weight:600}
.dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:#3CCB7F;margin-right:5px;vertical-align:middle}
.hero-band{background:linear-gradient(180deg,var(--navy) 0,var(--navy) 58px,var(--bg) 58px)}
.section{margin-top:22px}
.sec-t{display:flex;align-items:baseline;justify-content:space-between;gap:10px;margin-bottom:10px;flex-wrap:wrap}
.sec-t h2{font-family:Georgia,"Times New Roman",serif;font-size:17px;font-weight:600;color:var(--navy)}
.sec-t .k{font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:#5B72B5;font-weight:700}
.sec-t .note{font-size:11.5px;color:var(--mut)}
.card{background:var(--card);border:1px solid var(--line);border-radius:10px;box-shadow:0 1px 3px rgba(0,0,0,.05)}
.pad{padding:14px 16px}
.grid{display:grid;gap:12px}
.g2{grid-template-columns:1fr 1fr}.g3{grid-template-columns:repeat(3,1fr)}
.g-73{grid-template-columns:1.7fr 1fr}
@media(max-width:900px){.g2,.g3,.g-73{grid-template-columns:1fr}}
.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;position:relative}
@media(max-width:900px){.kpis{grid-template-columns:repeat(2,1fr)}}
.kpi{background:#fff;border:1px solid var(--line);border-top:3px solid var(--gold);border-radius:10px;padding:11px 13px;box-shadow:0 2px 6px rgba(0,0,0,.06)}
.kpi .l{font-size:9.5px;color:var(--mut);text-transform:uppercase;letter-spacing:.08em;font-weight:600}
.kpi .v{font-family:Georgia,"Times New Roman",serif;font-size:24px;color:var(--navy);margin-top:2px;font-variant-numeric:tabular-nums;line-height:1.15}
.kpi .s{font-size:10.5px;color:var(--mut);margin-top:3px}
.bar{height:6px;background:#ECECE6;border-radius:4px;overflow:hidden;margin-top:6px}
.bar i{display:block;height:100%;background:var(--gold);border-radius:4px}
.acct{display:grid;grid-template-columns:1fr 280px;gap:12px;align-items:stretch}
@media(max-width:900px){.acct{grid-template-columns:1fr}}
.mkt{background:#fff;border:1px solid var(--line);border-radius:12px;overflow:hidden}
.mkt .hd{padding:12px 16px;color:#fff;display:flex;justify-content:space-between;align-items:baseline;background:#5B72B5}
.mkt .hd b{font-family:Georgia,serif;font-size:17px;font-weight:600}
.mkt .hd span{font-size:11px;opacity:.85}
.mkt table{width:100%;border-collapse:collapse}
.mkt td{padding:7px 16px;border-bottom:1px solid #F0F0EA;font-size:12.5px}
.mkt td:last-child{text-align:right;font-variant-numeric:tabular-nums;font-weight:600;color:var(--navy)}
.mkt tr.big td{font-size:14px;background:#F7F8FC}
.mkt tr.big td:last-child{font-family:Georgia,serif;font-size:18px}
.verdict{background:var(--navy);color:#fff;border-radius:12px;padding:16px;display:flex;flex-direction:column;justify-content:center;gap:10px;text-align:center}
.verdict .day{font-family:Georgia,serif;font-size:30px;line-height:1}
.verdict .day small{font-size:13px;color:#C9C9C9}
.verdict .prog{height:6px;background:rgba(255,255,255,.15);border-radius:4px;overflow:hidden}
.verdict .prog i{display:block;height:100%;background:var(--gold)}
.verdict .call{font-size:12.5px;line-height:1.4}
.verdict .call b{color:var(--gold2)}
.verdict .rule{font-size:10.5px;color:#AEAEAE;line-height:1.35}
table.t{width:100%;border-collapse:collapse;font-size:12px}
table.t th{text-align:left;font-size:9.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--mut);font-weight:700;padding:8px 10px;border-bottom:1.5px solid var(--navy);white-space:nowrap}
table.t td{padding:7px 10px;border-bottom:1px solid #F0F0EA;vertical-align:middle}
table.t td.n,table.t th.n{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}
table.t tr:hover td{background:#F7F8FC}
.scroll{overflow-x:auto}
.tall{max-height:460px;overflow-y:auto}
.pill{display:inline-block;font-size:9.5px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;padding:2px 7px;border-radius:10px;white-space:nowrap}
.p-pm{background:#E4E9F7;color:#3D5498}.p-nb{background:#DDF0FF;color:#0068AD}.p-co{background:#F4ECDD;color:#7A5B25}.p-br{background:#ECECEC;color:#4F4F4F}
.p-bad{background:#FBE3E0;color:var(--bad)}.p-ok{background:#E1F2E8;color:var(--good)}.p-warn{background:#FBEFD8;color:#8A5C0B}.p-mut{background:#EFEFEA;color:var(--mut)}
.chart svg{display:block;width:100%;height:auto}
.legend{display:flex;gap:14px;flex-wrap:wrap;font-size:11px;color:var(--mut);margin-top:6px}
.legend i{display:inline-block;width:10px;height:10px;border-radius:2px;margin-right:5px;vertical-align:-1px}
.funnel .row{display:grid;grid-template-columns:170px 1fr;gap:12px;align-items:center;margin:6px 0}
.funnel .lbl{font-size:11.5px;color:var(--mut)}
.funnel .fb{position:relative;height:22px;background:#F2F2EE;border-radius:5px;overflow:hidden}
.funnel .fb i{position:absolute;left:0;top:0;bottom:0;border-radius:5px}
.funnel .fb span{position:absolute;left:8px;top:3px;font-size:11.5px;font-weight:700;color:var(--navy);font-variant-numeric:tabular-nums}
.funnel .fb em{position:absolute;right:8px;top:4px;font-size:10px;color:var(--mut);font-style:normal}
.fh{display:grid;grid-template-columns:170px 1fr;gap:12px;font-size:10px;letter-spacing:.08em;text-transform:uppercase;font-weight:700}
.minis{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:10px}
@media(max-width:600px){.minis{grid-template-columns:repeat(2,1fr)}}
.mini{background:#F7F8FC;border:1px solid #E8EBF3;border-radius:8px;padding:8px 10px}
.mini .l{font-size:9.5px;text-transform:uppercase;letter-spacing:.07em;color:var(--mut);font-weight:600}
.mini .v{font-family:Georgia,serif;font-size:19px;color:var(--navy)}
.alert{background:#FBEFD8;border:1px solid #F0D9A8;color:#6B4A0A;border-radius:8px;padding:8px 12px;font-size:12px;margin-bottom:10px}
.empty{color:var(--mut);font-size:12px;padding:18px;text-align:center;background:#F7F7F4;border-radius:8px}
#gate{position:fixed;inset:0;background:var(--navy);display:flex;align-items:center;justify-content:center;z-index:10;padding:16px}
#gate form{background:#fff;border-radius:12px;padding:26px 24px;width:100%;max-width:340px;display:flex;flex-direction:column;gap:10px;text-align:center}
#gate img{width:48px;height:48px;border-radius:50%;margin:0 auto 2px}
#gate h1{font-family:Georgia,serif;font-size:19px;font-weight:600;color:var(--navy)}
#gate p{font-size:12px;color:var(--mut);margin-bottom:6px}
#gate input{font:inherit;font-size:14px;padding:10px 12px;border:1px solid var(--line);border-radius:8px;width:100%}
#gate input:focus{outline:2px solid var(--gold);border-color:transparent}
#gate button{font:inherit;font-size:14px;font-weight:600;padding:10px;border:0;border-radius:8px;background:var(--navy);color:#fff;cursor:pointer}
#gate button:disabled{opacity:.6;cursor:wait}
#gate label{font-size:12px;color:var(--mut);display:flex;gap:6px;align-items:center;justify-content:center}
#gate label input{width:auto}
#gate .err{color:var(--bad);font-size:12px;min-height:16px}
footer{margin-top:28px;font-size:11px;color:var(--mut);border-top:1px solid var(--line);padding-top:12px;display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap}
</style>
</head>
<body>
<div id="gate"><form id="login" autocomplete="on">
  <img src="logo.png" alt=""><h1>Bean Watch</h1><p>Performance Dashboard</p>
  <input id="u" name="username" autocomplete="username" placeholder="User" required>
  <input id="pw" name="password" type="password" autocomplete="current-password" placeholder="Password" required>
  <label><input type="checkbox" id="rem" checked> Keep me signed in on this device</label>
  <button id="go" type="submit">Sign in</button><div class="err" id="err"></div>
</form></div>
<header class="top"><div class="wrap">
  <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap"><img src="logo.png" alt=""><span class="brand">Bean Watch</span><span class="ttl">Performance Dashboard</span></div>
  <div class="meta" id="meta">Loading…</div>
</div></header>
<div class="hero-band"><div class="wrap"><div class="kpis" id="kpis"></div></div></div>
<div class="wrap" id="root"></div>

<script>
const $=(s)=>document.querySelector(s);
const fm=(n)=>n==null||isNaN(n)||!isFinite(n)?'–':Math.round(Number(n)).toLocaleString('en-US');
const usd=(n)=>n==null||isNaN(n)||!isFinite(n)?'–':'$'+fm(n);
const usd2=(n)=>n==null||isNaN(n)||!isFinite(n)?'–':'$'+Number(n).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2});
const pct=(n)=>n==null||isNaN(n)||!isFinite(n)?'–':fm(n*100)+'%';
const div=(a,b)=>b?a/b:null;
const esc=(s)=>String(s??'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const C={'PMax':'#5B72B5','Non-Brand':'#0099FF','Competitor':'#C9A45C','Brand':'#A3A3A3',ink:'#111111'};
const GL={'PMax':'Performance Max','Non-Brand':'Search, non-brand','Competitor':'Search, competitor','Brand':'Search, brand'};
const pill=(g)=>`<span class="pill ${({'PMax':'p-pm','Non-Brand':'p-nb','Competitor':'p-co','Brand':'p-br'})[g]}">${esc(g)}</span>`;
const statusPill=(st)=>st==='ENABLED'?'<span class="pill p-ok">Active</span>':st==='PAUSED'?'<span class="pill p-mut">Paused</span>':st?`<span class="pill p-mut">${esc(st[0]+st.slice(1).toLowerCase())}</span>`:'–';
const section=(k,t,note,body)=>`<div class="section"><div class="sec-t"><div><div class="k">${k}</div><h2>${t}</h2></div>${note?`<div class="note">${note}</div>`:''}</div>${body}</div>`;
const fdate=(s)=>new Date(s+'T12:00:00').toLocaleString('en-US',{month:'short',day:'numeric'});

function barsSVG(days,keys,lineKey){
  const W=760,H=220,P={l:44,r:40,t:14,b:28};
  const n=days.length||1, bw=Math.min(46,(W-P.l-P.r)/n*0.62);
  const tot=days.map(d=>keys.reduce((a,k)=>a+(d.groups[k]?.spend||0),0));
  const maxS=Math.max(1,...tot)*1.15, line=days.map(d=>keys.reduce((a,k)=>a+(d.groups[k]?.[lineKey]||0),0));
  const maxL=Math.max(1,...line)*1.25;
  const x=(i)=>P.l+(W-P.l-P.r)*(i+0.5)/n, y=(v)=>H-P.b-(H-P.t-P.b)*v/maxS, yl=(v)=>H-P.b-(H-P.t-P.b)*v/maxL;
  let g='';
  for(let t=0;t<=4;t++){const v=maxS*t/4;g+=`<line x1="${P.l}" x2="${W-P.r}" y1="${y(v)}" y2="${y(v)}" stroke="#ECECE6"/><text x="${P.l-6}" y="${y(v)+3}" font-size="9.5" text-anchor="end" fill="#8A8A8A">$${fm(v)}</text>`}
  days.forEach((d,i)=>{let acc=0;keys.forEach(k=>{const v=d.groups[k]?.spend||0;if(!v)return;g+=`<rect x="${x(i)-bw/2}" y="${y(acc+v)}" width="${bw}" height="${y(acc)-y(acc+v)}" fill="${C[k]}" rx="2"><title>${k}: $${fm(v)}</title></rect>`;acc+=v});
    g+=`<text x="${x(i)}" y="${H-P.b+14}" font-size="9.5" text-anchor="middle" fill="#8A8A8A">${d.date.slice(5)}</text>`});
  if(line.some(v=>v>0)){g+=`<polyline fill="none" stroke="#111" stroke-width="2" points="${line.map((v,i)=>`${x(i)},${yl(v)}`).join(' ')}"/>`;line.forEach((v,i)=>g+=`<circle cx="${x(i)}" cy="${yl(v)}" r="3.2" fill="#111"><title>${fm(v)} reservations</title></circle>`);
    for(let t=0;t<=2;t++){const v=maxL*t/2;g+=`<text x="${W-P.r+6}" y="${yl(v)+3}" font-size="9.5" fill="#111">${fm(v)}</text>`}}
  return `<svg viewBox="0 0 ${W} ${H}">${g}</svg>`;
}
function hBars(items,max,color){
  max=max||Math.max(1,...items.map(i=>i.value));
  return items.map(i=>`<div style="display:grid;grid-template-columns:150px 1fr 110px;gap:8px;align-items:center;margin:5px 0"><div style="font-size:11.5px;color:#4F4F4F;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${esc(i.label)}</div><div style="height:14px;background:#F2F2EE;border-radius:4px;overflow:hidden"><div style="height:100%;width:${Math.max(i.value?2:0,100*i.value/max)}%;background:${i.color||color};border-radius:4px"></div></div><div style="font-size:11.5px;text-align:right;font-variant-numeric:tabular-nums;font-weight:600">${i.sub??fm(i.value)}</div></div>`).join('');
}
function hoursSVG(hours){
  const W=760,H=150,P={l:26,r:10,t:10,b:22},bw=(W-P.l-P.r)/24;
  const mx=Math.max(1,...hours.map(h=>h.clicks));
  let g='';
  hours.forEach((h,i)=>{const x=P.l+i*bw, hh=(H-P.t-P.b)*h.clicks/mx;
    g+=`<rect x="${x+3}" y="${H-P.b-hh}" width="${bw-6}" height="${hh}" fill="#0099FF" rx="1.5"><title>${i}:00 · ${h.clicks} clicks, $${fm(h.spend)}</title></rect>`;
    if(i%3===0)g+=`<text x="${x+bw/2}" y="${H-6}" font-size="9.5" text-anchor="middle" fill="#8A8A8A">${i}h</text>`});
  return `<svg viewBox="0 0 ${W} ${H}">${g}</svg>`;
}
function donut(parts,center){
  const tot=parts.reduce((a,p)=>a+p.value,0); const R=46,r=30,cx=60,cy=60; let a0=-Math.PI/2,g='';
  if(!tot) g=`<circle cx="${cx}" cy="${cy}" r="${(R+r)/2}" fill="none" stroke="#ECECE6" stroke-width="${R-r}"/>`;
  parts.forEach(p=>{if(!p.value)return;const a1=a0+2*Math.PI*p.value/tot, big=a1-a0>Math.PI?1:0;
    const P=(a,rr)=>`${cx+rr*Math.cos(a)},${cy+rr*Math.sin(a)}`;
    g+= p.value===tot?`<circle cx="${cx}" cy="${cy}" r="${(R+r)/2}" fill="none" stroke="${p.color}" stroke-width="${R-r}"/>`:`<path d="M${P(a0,R)} A${R},${R} 0 ${big} 1 ${P(a1,R)} L${P(a1,r)} A${r},${r} 0 ${big} 0 ${P(a0,r)} Z" fill="${p.color}"/>`;a0=a1});
  g+=`<text x="${cx}" y="${cy+2}" text-anchor="middle" font-family="Georgia" font-size="18" fill="#111">${center??fm(tot)}</text><text x="${cx}" y="${cy+15}" text-anchor="middle" font-size="8.5" fill="#8A8A8A">TOTAL</text>`;
  return `<div style="display:flex;align-items:center;gap:14px"><svg viewBox="0 0 120 120" style="width:120px;flex:none">${g}</svg><div>${parts.map(p=>`<div style="font-size:12px;margin:4px 0"><i style="display:inline-block;width:10px;height:10px;border-radius:2px;background:${p.color};margin-right:6px"></i>${esc(p.label)} <b>${p.fmt?p.fmt(p.value):fm(p.value)}</b> <span style="color:#8A8A8A">${tot?pct(p.value/tot):''}</span></div>`).join('')}</div></div>`;
}

// Los datos van cifrados (AES-256-GCM, clave PBKDF2 de "usuario:contraseña"): sin la
// contraseña no se pueden leer, aunque data.enc.json sea público.
const KEY_STORE='beanwatch-key';
const b64=(s)=>Uint8Array.from(atob(s),c=>c.charCodeAt(0));
let ENC=null;
async function loadEnc(){ if(!ENC) ENC=await (await fetch('data.enc.json?v='+Date.now())).json(); return ENC; }
async function deriveRaw(user,pass,e){
  const base=await crypto.subtle.importKey('raw',new TextEncoder().encode(user+':'+pass),'PBKDF2',false,['deriveBits']);
  return new Uint8Array(await crypto.subtle.deriveBits({name:'PBKDF2',hash:'SHA-256',salt:b64(e.salt),iterations:e.iter},base,256));
}
async function decrypt(raw,e){
  const key=await crypto.subtle.importKey('raw',raw,'AES-GCM',false,['decrypt']);
  const pt=await crypto.subtle.decrypt({name:'AES-GCM',iv:b64(e.iv)},key,b64(e.ct));
  return JSON.parse(new TextDecoder().decode(pt));
}
function showDash(d){
  if(!d||!d.account) throw new Error('Unexpected data format. Please refresh with Cmd+Shift+R (Ctrl+F5 on Windows).');
  document.getElementById('gate').remove(); render(d);
}
// Sesión recordada: se guarda la clave derivada (nunca la contraseña) junto con la sal.
(async()=>{
  let saved=null; try{saved=JSON.parse(localStorage.getItem(KEY_STORE)||sessionStorage.getItem(KEY_STORE)||'null')}catch(e){}
  if(!saved) { $('#u').focus(); return; }
  try{ const e=await loadEnc(); if(saved.salt!==e.salt) throw 0; showDash(await decrypt(b64(saved.k),e)); }
  catch(e){ try{localStorage.removeItem(KEY_STORE);sessionStorage.removeItem(KEY_STORE)}catch(_){} }
})();
$('#login').addEventListener('submit',async(ev)=>{
  ev.preventDefault(); $('#err').textContent=''; $('#go').disabled=true; $('#go').textContent='Signing in…';
  try{
    const e=await loadEnc(); const raw=await deriveRaw($('#u').value.trim(),$('#pw').value,e);
    let d; try{ d=await decrypt(raw,e); }catch(_){ throw new Error('Wrong user or password.'); }
    try{ const v=JSON.stringify({salt:e.salt,k:btoa(String.fromCharCode(...raw))}); ($('#rem').checked?localStorage:sessionStorage).setItem(KEY_STORE,v); }catch(_){}
    showDash(d);
  }catch(err){ $('#err').textContent=err.message||'Could not load data.'; $('#go').disabled=false; $('#go').textContent='Sign in'; }
});

function render(d){
  const upd=new Date(d.generated);
  $('#meta').innerHTML=`<div><span class="dot"></span>Updated <b>${upd.toLocaleString('en-US',{timeZone:'America/New_York',month:'short',day:'numeric',hour:'numeric',minute:'2-digit'})} ET</b></div><div>Campaign period ${d.launch} to ${d.today}</div>`;
  const A=d.account, G=d.groups||{};

  // KPIs
  const W=d.weekly||{}, cur=W.current||{}, prv=W.previous||{};
  const chg=(k,inv)=>{ if(!W.comparable) return ''; const a=cur[k]||0,b=prv[k]||0; if(!b) return ''; const r=(a-b)/b, up=r>=0, good=inv?!up:up;
    return `<span style="color:${good?'#2E8B57':'#C0392B'};font-weight:600">${up?'▲':'▼'} ${pct(Math.abs(r))}</span> vs previous 7 days`; };
  const weekNote=W.comparable?'':`Week-over-week comparison starts ${fdate(W.availableFrom||d.today)}`;
  const P=d.pacing||{}, pr=div(P.projected,P.plan);
  const monthName=P.month?new Date(P.month+'-15T12:00:00').toLocaleString('en-US',{month:'long'}):'';
  $('#kpis').innerHTML=[
    {l:`${monthName} spend`,v:usd(P.spentToDate),s:`On pace for <b>${usd(P.projected)}</b> vs ${usd(P.plan)} planned (${pct(pr)})`,bar:Math.min(1,pr||0),barColor:pr>1.1?'#C98A1B':'#8AA0DB'},
    {l:'Clicks, last 7 days',v:fm(cur.clicks),s:chg('clicks')||`CTR ${pct(div(cur.clicks,cur.impr))} · Avg CPC ${usd2(div(cur.spend,cur.clicks))}`},
    {l:'Reservations, last 7 days',v:fm(cur.reserved),s:chg('reserved')||(cur.reserved?`${usd(div(cur.spend,cur.reserved))} per reservation`:'$29 deposits that lock the $299 price')},
    {l:'Revenue from ads',v:usd(A.value),s:A.value?`${(A.value/A.spend).toFixed(2)}x return on ad spend`:'Deposits plus paid-in-full upgrades'},
  ].map(k=>`<div class="kpi"><div class="l">${k.l}</div><div class="v">${k.v}</div><div class="s">${k.s}</div>${k.bar!=null?`<div class="bar"><i style="width:${100*k.bar}%;background:${k.barColor||'#8AA0DB'}"></i></div>`:''}</div>`).join('')+(weekNote?`<div style="grid-column:1/-1;font-size:10.5px;color:#8A8A8A;margin-top:-4px">${weekNote}. Spend projection is based on the last ${P.basedOnDays||0} full day${P.basedOnDays===1?'':'s'} of spend.</div>`:'');

  let h='';
  // ---------- THE ACCOUNT
  const cpr=div(A.spend,A.reserved), roas=div(A.value,A.spend);
  const gRow=(name,g,col)=>`<tr><td><span style="display:inline-block;width:9px;height:9px;border-radius:2px;background:${col};margin-right:7px"></span>${name}</td><td class="n">${usd(g.spend)}</td><td class="n">${fm(g.impr)}</td><td class="n">${fm(g.clicks)}</td><td class="n">${pct(div(g.clicks,g.impr))}</td><td class="n">${usd2(div(g.spend,g.clicks))}</td><td class="n">${fm(g.resView)}</td><td class="n">${fm(g.reserved)}</td><td class="n">${usd(div(g.spend,g.reserved))}</td><td class="n">${pct(div(g.spend,A.spend))}</td></tr>`;
  const acctCard=`<div class="mkt"><div class="hd"><b>Whole account</b><span>All campaigns · ${d.daysLive} day${d.daysLive>1?'s':''} live</span></div><table>
    <tr><td>Spend</td><td>${usd(A.spend)}</td></tr>
    <tr><td>Impressions · clicks</td><td>${fm(A.impr)} · ${fm(A.clicks)}</td></tr>
    <tr><td>CTR</td><td>${pct(div(A.clicks,A.impr))}</td></tr>
    <tr><td>Avg CPC</td><td>${usd2(div(A.spend,A.clicks))}</td></tr>
    <tr><td>Reservation page views</td><td>${fm(A.resView)}</td></tr>
    <tr><td>Checkouts started</td><td>${fm(A.checkout)}</td></tr>
    <tr><td>Reservations ($29 deposit)</td><td>${fm(A.reserved)}</td></tr>
    <tr><td>Paid in full (upsell)</td><td>${fm(A.upsell)}</td></tr>
    <tr><td>Revenue · return on ad spend</td><td>${usd(A.value)} · ${roas?roas.toFixed(2)+'x':'–'}</td></tr>
    <tr class="big"><td>Cost per reservation</td><td>${usd(cpr)}</td></tr></table></div>`;
  const verdict=`<div class="verdict"><div class="day">${d.daysLive}<small> / ${d.testDays} days</small></div>
    <div class="prog"><i style="width:${Math.min(100,100*d.daysLive/d.testDays)}%"></i></div>
    <div class="call">${A.reserved>=5?`<b>${fm(A.reserved)} reservations</b> at ${usd(cpr)} each.`:A.resView>=20?`<b>${fm(A.resView)} people</b> reached the reservation page. Reservations decide.`:'<b>Too early to call.</b> The account needs reservations before the numbers mean anything.'}</div>
    <div class="rule">Performance Max is the volume engine: the category has almost no search demand yet. Search harvests the intent that exists.</div></div>`;
  h+=section('Account','How the account is doing',`Everything on this page is the full Google Ads account · ${d.daysLive} day${d.daysLive>1?'s':''} live`,
    `<div class="acct">${acctCard}${verdict}</div>
     <div class="card scroll" style="margin-top:12px"><table class="t"><thead><tr><th>Where the money goes</th><th class="n">Spend</th><th class="n">Impr.</th><th class="n">Clicks</th><th class="n">CTR</th><th class="n">Avg CPC</th><th class="n">Res. page views</th><th class="n">Reservations</th><th class="n">Cost / res.</th><th class="n">Share of spend</th></tr></thead><tbody>${['PMax','Non-Brand','Competitor','Brand'].map(g=>gRow(GL[g],G[g]||{},C[g])).join('')}</tbody></table></div>`);

  // ---------- DAILY + MIX
  const mix=['PMax','Non-Brand','Competitor','Brand'].map(g=>({label:GL[g],value:G[g]?.spend||0,color:C[g],fmt:usd}));
  h+=section('Daily','Spend and reservations by day','',`<div class="grid g-73"><div class="card pad chart">${d.daily.length?barsSVG(d.daily,['PMax','Non-Brand','Competitor','Brand'],'reserved'):'<div class="empty">No data yet</div>'}<div class="legend">${['PMax','Non-Brand','Competitor','Brand'].map(g=>`<span><i style="background:${C[g]}"></i>${GL[g]}</span>`).join('')}<span><i style="background:#111;height:3px;vertical-align:3px"></i>Reservations (right axis)</span></div></div>
    <div class="card pad"><div style="font-size:12px;font-weight:700;color:var(--navy);margin-bottom:8px">Spend by campaign type</div>${donut(mix,usd(A.spend))}<div style="font-size:11px;color:var(--mut);margin-top:10px">Budget split: $120 a day to Performance Max and $80 across the three Search campaigns.</div></div></div>`);

  // ---------- FUNNEL
  const fsteps=[['Impressions','impr'],['Clicks','clicks'],['Reservation page views','resView'],['Checkouts started','checkout'],['Reservations','reserved'],['Paid in full','upsell']];
  const fa=(()=>{const m=A,top=Math.max(1,m.impr);return fsteps.map(([l,k],i)=>{const v=m[k]||0, prev=i?m[fsteps[i-1][1]]||0:null;const w=i===0?100:Math.max(v?3:0,100*Math.pow(v/top,0.35));return `<div class="fb"><i style="width:${w}%;background:#5B72B5;opacity:${0.3+0.7*(1-i/6)}"></i><span>${fm(v)}</span>${i?`<em>${prev?pct(v/prev):'–'} of the step above</em>`:''}</div>`})})();
  h+=section('Funnel','From impression to reservation','Every step is a page of the reservation flow, measured by Google Ads · bar width on a compressed scale',
    `<div class="card pad funnel"><div class="fh"><span></span><span style="color:#5B72B5">Whole account</span></div>${fsteps.map(([l],i)=>`<div class="row"><div class="lbl">${l}</div>${fa[i]}</div>`).join('')}</div>`);

  // ---------- CAMPAIGNS
  const shareCell=(s,k)=>s&&s[k]!=null?pct(Number(s[k])):'–';
  h+=section('Campaigns','Performance by campaign','Search impression share applies to Search campaigns only',
    `<div class="card scroll"><table class="t"><thead><tr><th>Campaign</th><th>Type</th><th>Status</th><th class="n">Spend</th><th class="n">Impr.</th><th class="n">Clicks</th><th class="n">CTR</th><th class="n">Avg CPC</th><th class="n">Res. page views</th><th class="n">Reservations</th><th class="n">Revenue</th><th class="n">Impr. share</th></tr></thead><tbody>${
    d.campaigns.slice().sort((a,b)=>b.spend-a.spend).map(c=>`<tr${c.status==='ENABLED'?'':' style="opacity:.62"'}><td style="white-space:nowrap"><b>${esc(c.short)}</b></td><td>${pill(c.group)}</td><td>${statusPill(c.status)}</td><td class="n">${usd2(c.spend)}</td><td class="n">${fm(c.impr)}</td><td class="n">${fm(c.clicks)}</td><td class="n">${pct(div(c.clicks,c.impr))}</td><td class="n">${usd2(div(c.spend,c.clicks))}</td><td class="n">${fm(c.resView)}</td><td class="n">${fm(c.reserved)}</td><td class="n">${usd(c.value)}</td><td class="n">${c.group==='PMax'?'–':shareCell(c.share,'is')}</td></tr>`).join('')}</tbody></table></div>`);

  // ---------- WEBSITE (GA4)
  const g=d.ga4; let gb='<div class="empty">Google Analytics data unavailable in this update.</div>';
  if(g){
    const pg=g.pages||[], S=pg.reduce((a,p)=>a+p.sessions,0), E=pg.reduce((a,p)=>a+p.engaged,0), T=pg.reduce((a,p)=>a+p.engagementSec,0);
    const allS=(g.sources||[]).reduce((a,x)=>a+x.sessions,0), adsS=(g.sources||[]).filter(x=>x.sm==='google / cpc').reduce((a,x)=>a+x.sessions,0);
    const gap=A.clicks>=20&&adsS<A.clicks*0.5;
    gb=`<div class="card pad">${gap?`<div class="alert">Google Analytics recorded ${fm(adsS)} sessions from Google Ads against ${fm(A.clicks)} ad clicks. Analytics is undercounting visits, so the funnel above uses Google Ads conversions instead.</div>`:''}<div class="minis"><div class="mini"><div class="l">Sessions</div><div class="v">${fm(S)}</div></div><div class="mini"><div class="l">Engagement rate</div><div class="v">${pct(div(E,S))}</div></div><div class="mini"><div class="l">Avg engaged time</div><div class="v">${fm(div(T,S))}s</div></div><div class="mini"><div class="l">From Google Ads</div><div class="v">${pct(div(adsS,allS))}</div></div></div>
      <div class="grid g2"><div><div style="font-size:12px;font-weight:700;color:var(--navy);margin-bottom:4px">Sessions by landing page</div>${pg.length?hBars(pg.filter(p=>p.sessions).slice(0,6).map(p=>({label:p.path,value:p.sessions,sub:`${fm(p.sessions)} · ${pct(div(p.engaged,p.sessions))} eng.`,color:'#5B72B5'}))):'<div class="empty">No sessions yet</div>'}</div>
      <div><div style="font-size:12px;font-weight:700;color:var(--navy);margin-bottom:4px">Where visitors come from</div>${(g.sources||[]).length?hBars(g.sources.slice(0,6).map(x=>({label:x.sm,value:x.sessions,color:x.sm==='google / cpc'?'#0099FF':'#A3A3A3'}))):'<div class="empty">No sessions yet</div>'}</div></div>
      <div class="scroll" style="margin-top:12px"><table class="t"><thead><tr><th>Landing page</th><th class="n">Sessions</th><th class="n">From Google Ads</th><th class="n">Engagement</th><th class="n">Avg time</th></tr></thead><tbody>${pg.filter(p=>p.sessions).map(p=>`<tr><td><b>${esc(p.path)}</b></td><td class="n">${fm(p.sessions)}</td><td class="n">${fm(p.adsSessions)}</td><td class="n">${pct(div(p.engaged,p.sessions))}</td><td class="n">${fm(div(p.engagementSec,p.sessions))}s</td></tr>`).join('')}</tbody></table></div></div>`;
  }
  h+=section('Website','What visitors do on the site (Google Analytics)','Only www.beanwatch.com · since launch',gb);

  // ---------- WHEN + DEVICES
  const dv=d.devices||{};
  h+=section('Timing and devices','When and where people click','Hours in Eastern time',
    `<div class="grid g-73"><div class="card pad chart">${hoursSVG(d.hours||[])}<div class="legend"><span><i style="background:#0099FF"></i>Ad clicks</span></div></div>
    <div class="card pad"><div style="font-size:12px;font-weight:700;color:var(--navy);margin-bottom:4px">Ad clicks by device</div>${hBars(['DESKTOP','MOBILE','TABLET'].map(k=>({label:k[0]+k.slice(1).toLowerCase(),value:dv[k]?.clicks||0,sub:`${fm(dv[k]?.clicks||0)} · ${usd2(div(dv[k]?.spend||0,dv[k]?.clicks||0))}`,color:'#0099FF'})))}</div></div>`);

  // ---------- KEYWORDS + TERMS
  const kw=(d.keywords||[]).slice(0,15), tm=(d.terms||[]).slice(0,20);
  h+=section('Search','Keywords and search terms','Search campaigns only · Performance Max does not report search terms here',`<div class="grid g2">
   <div class="card scroll"><table class="t"><thead><tr><th>Top keywords by spend</th><th>Campaign</th><th class="n">QS</th><th class="n">Clicks</th><th class="n">CPC</th><th class="n">Spend</th><th class="n">Res.</th></tr></thead><tbody>${kw.length?kw.map(k=>`<tr><td>[${esc(k.kw)}]<div style="font-size:10.5px;color:#8A8A8A">${esc(k.adGroup)}</div></td><td style="white-space:nowrap;font-size:11px;color:#4F4F4F">${esc(k.campaign)}</td><td class="n">${k.qs??'–'}</td><td class="n">${fm(k.clicks)}</td><td class="n">${usd2(div(k.spend,k.clicks))}</td><td class="n">${usd2(k.spend)}</td><td class="n">${fm(k.conv)}</td></tr>`).join(''):'<tr><td colspan="7" class="empty">No data yet</td></tr>'}</tbody></table></div>
   <div class="card scroll"><table class="t"><thead><tr><th>What people actually searched</th><th class="n">Impr.</th><th class="n">Clicks</th><th class="n">Spend</th><th>Status</th></tr></thead><tbody>${tm.length?tm.map(t=>`<tr><td>${esc(t.term)}</td><td class="n">${fm(t.impr)}</td><td class="n">${fm(t.clicks)}</td><td class="n">${usd2(t.spend)}</td><td>${t.excluded?'<span class="pill p-mut">Blocked</span>':t.conv>0?'<span class="pill p-ok">Converted</span>':t.spend>=30?'<span class="pill p-warn">Watch</span>':''}</td></tr>`).join(''):'<tr><td colspan="5" class="empty">No data yet</td></tr>'}</tbody></table></div></div>`);

  // ---------- NEGATIVE KEYWORDS
  const N=d.negatives; let nb='<div class="empty">No negative keyword data yet.</div>';
  if(N){
    const byList={}; N.added.forEach(a=>{byList[a.list]=(byList[a.list]||0)+1});
    const days={}; N.added.forEach(a=>{days[a.date]=(days[a.date]||0)+1});
    const blockedSpend=N.added.reduce((s,a)=>s+(a.spend||0),0);
    const setupTot=Object.values(N.setupLists||{}).reduce((a,b)=>a+b,0);
    nb=`<div class="card pad"><div class="minis"><div class="mini"><div class="l">Added by daily review</div><div class="v">${fm(N.added.length)}</div></div><div class="mini"><div class="l">Search terms reviewed</div><div class="v">${fm(N.reviewed)}</div></div><div class="mini"><div class="l">Kept as relevant</div><div class="v">${fm(N.relevant)}</div></div><div class="mini"><div class="l">On watch</div><div class="v">${fm(N.watching.length)}</div></div></div>
      <div class="grid g2"><div><div style="font-size:12px;font-weight:700;color:var(--navy);margin-bottom:4px">Added by category</div>${Object.keys(byList).length?hBars(Object.entries(byList).sort((a,b)=>b[1]-a[1]).map(([k,v])=>({label:k.replace(/^\d+\.\s*/,''),value:v,color:'#5B72B5'}))):'<div class="empty">None yet</div>'}</div>
      <div><div style="font-size:12px;font-weight:700;color:var(--navy);margin-bottom:4px">Added by day</div>${Object.keys(days).length?hBars(Object.entries(days).sort((a,b)=>b[0].localeCompare(a[0])).slice(0,10).map(([k,v])=>({label:fdate(k),value:v,color:'#A3A3A3'}))):'<div class="empty">None yet</div>'}<div style="font-size:11px;color:var(--mut);margin-top:8px">Plus ${fm(setupTot)} broad-match negatives set up at launch (${Object.entries(N.setupLists||{}).map(([k,v])=>`${esc(k.replace(/^NEG - /,''))} ${v}`).join(', ')}).</div></div></div>
      <div class="scroll tall" style="margin-top:12px"><table class="t"><thead><tr><th>Date</th><th>Blocked search</th><th>Category</th><th>Why</th><th class="n">Impr.</th><th class="n">Clicks</th><th class="n">Spend</th></tr></thead><tbody>${N.added.length?N.added.map(a=>`<tr><td style="white-space:nowrap">${fdate(a.date)}</td><td><b>${esc(a.term)}</b></td><td style="white-space:nowrap;font-size:11px;color:#4F4F4F">${esc(a.list.replace(/^\d+\.\s*/,''))}</td><td style="font-size:11.5px;color:#4F4F4F">${esc(a.reason||'')}</td><td class="n">${fm(a.impr)}</td><td class="n">${fm(a.clicks)}</td><td class="n">${usd2(a.spend)}</td></tr>`).join(''):'<tr><td colspan="7" class="empty">None yet</td></tr>'}</tbody></table></div>
      ${N.watching.length?`<details style="margin-top:12px"><summary style="cursor:pointer;font-size:12px;font-weight:700;color:var(--navy)">On watch: ${fm(N.watching.length)} searches that are unclear, left running for now</summary><div style="font-size:12px;color:#4F4F4F;margin-top:8px;line-height:1.8">${N.watching.map(w=>`<span class="pill p-mut" style="text-transform:none;letter-spacing:0;font-weight:600;margin:0 4px 4px 0">${esc(w.term)}</span>`).join('')}</div></details>`:''}
      <div style="font-size:11px;color:var(--mut);margin-top:10px">Every day an automated review reads the new search terms and blocks the ones that will not reserve a Bean Watch, in exact match only, so it never blocks anything wider than that one search. Terms that converted, match our own keywords or mention the brand are never touched. Spend shown is what the term cost before it was blocked: ${usd2(blockedSpend)} in total.</div></div>`;
  }
  h+=section('Negative keywords','Searches we stopped paying for','Daily automated review of search terms, since launch',nb);

  const s=d.sources, srcs=[['Google Ads',s.googleAds],['Google Analytics',s.ga4],['Negative keyword review',s.negatives]];
  h+=`<footer><div>Sources: ${srcs.map(([n,ok])=>`${n} ${ok?'✓':'✗'}`).join(' · ')}${s.errors?.length?` · <span style="color:var(--bad)">${esc(s.errors.join(' | '))}</span>`:''}</div><div>Updated daily · Bean Watch</div></footer>`;
  $('#root').innerHTML=h;
}
</script>
</body>
</html>
